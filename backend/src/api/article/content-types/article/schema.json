{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Genre": {
      "type": "enumeration",
      "enum": [
        "Politics",
        "Economics",
        "Science",
        "Sports",
        "Culture"
      ]
    },
    "Author": {
      "type": "string"
    },
    "Content": {
      "type": "blocks"
    },
    "Date_pub": {
      "type": "date"
    },
    "slug": {
      "type": "uid"
    },
    "Type": {
      "type": "enumeration",
      "enum": [
        "opinion",
        "analysis",
        "editorial"
      ]
    },
    "Featured": {
      "type": "boolean"
    },
    "picture": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    }
  }
}