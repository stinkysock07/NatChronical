# Backend Environment Variables (Strapi) - LOCAL DEVELOPMENT
# Copy this file to .env and fill in the values with your own keys
# Most will be configured by strapi on install


# ============ Server Configuration ============
HOST=0.0.0.0
PORT=1337
FRONTEND_URL=https://www.natchronicle.com

# ============ Secrets & Security Keys ============
# Generate new keys for security - DO NOT use these example values in production
# These are comma-separated values for key rotation
APP_KEYS=your_app_key_1,your_app_key_2,your_app_key_3,your_app_key_4
API_TOKEN_SALT=your_api_token_salt_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
TRANSFER_TOKEN_SALT=your_transfer_token_salt_here
ENCRYPTION_KEY=your_encryption_key_here

# ============ External Service APIs ============
# Twitter/X Bearer Token for tweet fetching
# Get from https://developer.twitter.com
X_BEARERS_TOKEN=your_twitter_bearer_token_here

# Twitter/X API Key (same as frontend)
TWEETS_API_KEY=your_tweets_api_key_here

# ============ Database Configuration ============
DATABASE_CLIENT=sqlite
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=.tmp/data.db

# ============ JWT Configuration ============
JWT_SECRET=your_jwt_secret_here
